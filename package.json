{
  "name": "dso-docs",
  "version": "1.0.0",
  "description": "DSO Documentation",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "landing:dev": "npx @tailwindcss/cli -i ./landing-page-premium/input.css -o ./landing-page-premium/output.css --watch",
    "landing:build": "npx @tailwindcss/cli -i ./landing-page-premium/input.css -o ./landing-page-premium/output.css --minify",
    "build": "npm run landing:build && npm run docs:build",
    "postbuild": "mkdir -p landing-page-premium/docs && cp -r docs/.vitepress/dist/* landing-page-premium/docs/",
    "dev": "npm run landing:dev"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "mermaid": "^11.14.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
